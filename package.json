{
  "name": "icloudkeys",
  "version": "0.1.0",
  "description": "Apple Passwords (iCloud Keychain) and Hide My Email for Chromium browsers on macOS",
  "license": "Apache-2.0",
  "author": "Md Mobshshir Nayeem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TowardInfinity/icloudkeys.git"
  },
  "homepage": "https://github.com/TowardInfinity/icloudkeys#readme",
  "bugs": {
    "url": "https://github.com/TowardInfinity/icloudkeys/issues"
  },
  "keywords": [
    "apple-passwords",
    "icloud-keychain",
    "hide-my-email",
    "chromium-extension",
    "macos",
    "brave",
    "chrome",
    "passwords"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "benchmark": "pnpm --filter @icloudkeys/classifier benchmark",
    "typecheck": "pnpm -r typecheck",
    "package:extension": "pnpm build && (cd targets/chromium/dist && zip -rq ../../../icloudkeys-v0.1.0.zip .)"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
